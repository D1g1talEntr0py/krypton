{
  "name": "@d1g1tal/krypton",
  "author": "D1g1talEntr0py",
  "version": "3.0.0",
  "license": "MIT",
  "description": "Simple wrapper for the Web Crypto API",
  "homepage": "https://github.com/D1g1talEntr0py/krypton#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1g1talEntr0py/krypton.git"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/krypton/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "types": "./dist/krypton.d.ts",
  "exports": {
    ".": {
      "types": "./dist/krypton.d.ts",
      "import": "./dist/krypton.js"
    },
    "./ciphers/*": {
      "types": "./dist/ciphers/*.d.ts",
      "import": "./dist/ciphers/*.js"
    }
  },
  "files": [
    "./dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsbuild",
    "build:watch": "tsbuild --watch",
    "type-check": "tsbuild --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "test": "vitest run",
    "test:browser": "vitest run --browser --config vitest.browser.config.ts",
    "test:package": "node scripts/package-smoke-test.js",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@d1g1tal/tsbuild": "^3.1.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsdoc": "^65.4.5",
    "playwright": "^1.65.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "defaults",
    "not ios_saf < 15",
    "not op_mini all"
  ],
  "keywords": [
    "Crypto",
    "Encryption"
  ]
}
